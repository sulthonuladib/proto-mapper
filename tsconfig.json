{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // The virtual modules the mapper answers with are never emitted; this project only type-checks.
    // (Also satisfies option 5096's requirement for allowImportingTsExtensions without the CLI flag.)
    "noEmit": true,
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  // The language this project speaks besides TypeScript. `--runExternalCode` lets tsc run it.
  "contentMappers": [{ "package": "proto-mapper", "extensions": [".proto"] }],
  "include": ["src", "proto", "proto-mapper/src", "tools"]
}
